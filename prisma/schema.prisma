datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// AUTH & MULTI-TENANCY
// ==========================================

enum UserRole {
  SUPER_ADMIN
  OWNER
  MANAGER
}

model User {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  name           String?
  email          String    @unique
  password       String
  phone          String?
  role           UserRole  @default(OWNER)
  organizationId String?   @db.ObjectId // null for SUPER_ADMIN
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  pushSubscriptions PushSubscription[]

  @@index([organizationId])
}

// ==========================================
// ORGANIZATION / MULTI-TENANT
// ==========================================

enum PlanType {
  FREE
  STARTER
  BUILDER
  PORTFOLIO
}

enum PlanStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  ANNUAL
}

model Organization {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  name        String       // Business or building name
  ownerName   String       // Full name of the owner
  email       String       @unique
  phone       String
  city        String       @default("Hyderabad")

  // Subscription
  plan          PlanType     @default(STARTER)
  planStatus    PlanStatus   @default(PENDING_PAYMENT)
  maxUnits      Int          @default(20)
  billingCycle  BillingCycle @default(YEARLY)
  subscriptionStart DateTime?
  subscriptionEnd   DateTime?

  // Owner's Payment Config (for tenant rent collection)
  upiId         String?    // owner@upi  
  bankName      String?
  accountNumber String?
  ifscCode      String?
  accountHolder String?
  paymentInstructions String?  // custom text shown to tenants
  paymentMethods      Json?    // Array of { id, type: 'UPI'|'BANK', label, upiId?, bankName?, accountNumber?, ifscCode?, accountHolder?, isDefault }

  // WhatsApp Business API (Centralized Model)
  // Fields removed: PropX will send all messages via the global SaaS WhatsApp configuration.

  // Status
  isActive    Boolean  @default(false) // activated after payment verified by super admin
  isSuspended Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                User[]
  buildings            Building[]
  subscriptionPayments SubscriptionPayment[]
  notifications        Notification[]
}

model SubscriptionPayment {
  id               String       @id @default(auto()) @map("_id") @db.ObjectId
  organizationId   String       @db.ObjectId
  amount           Float
  plan             PlanType
  billingCycle     BillingCycle
  upiTransactionId String?
  screenshotUrl    String?      // uploaded payment proof image
  status           String       @default("PENDING") // PENDING, VERIFIED, REJECTED
  verifiedBy       String?      @db.ObjectId // super admin user id
  verifiedAt       DateTime?
  periodStart      DateTime
  periodEnd        DateTime
  notes            String?
  createdAt        DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

// ==========================================
// PROPERTY STRUCTURE
// ==========================================

enum FlatType {
  STUDIO
  BHK1
  BHK2
  BHK3
  OTHER
}

model Building {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  organizationId  String?  @db.ObjectId  // multi-tenancy key
  name            String
  address         String
  city            String   @default("Hyderabad")
  latitude        Float?
  longitude       Float?
  totalFloors     Int      @default(0)
  totalFlats      Int      @default(0)
  occupancyRate   Float    @default(0.0)
  ratePerUnit     Float    @default(10.0)
  defaultRentBHK1 Float    @default(8000)
  defaultRentBHK2 Float    @default(12000)
  defaultRentBHK3 Float    @default(16000)
  rentDueDay      Int      @default(5)
  lateFeePercent  Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization        Organization?         @relation(fields: [organizationId], references: [id])
  floors              Floor[]
  flats               Flat[]
  maintenanceRequests MaintenanceRequest[]
  tenantInquiries     TenantInquiry[]

  @@index([organizationId])
}

model Floor {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  buildingId String @db.ObjectId
  number     Int
  flatsCount Int    @default(0)

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  flats    Flat[]

  @@index([buildingId])
}

enum FlatStatus {
  OCCUPIED
  VACANT
  UNDER_MAINTENANCE
}

enum ElectricityType {
  METERED
  FIXED
}

model Flat {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId
  buildingId        String          @db.ObjectId
  floorId           String          @db.ObjectId
  flatNumber        String
  flatType          FlatType        @default(BHK1)
  rentAmount        Float
  maintenanceAmount Float           @default(0.0)
  depositAmount     Float           @default(0.0)
  electricityType   ElectricityType @default(METERED)
  status            FlatStatus      @default(VACANT)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  building      Building           @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  floor         Floor              @relation(fields: [floorId], references: [id], onDelete: Cascade)
  tenants       Tenant[]
  payments      Payment[]
  meterReadings MeterReading[]
  maintenance   MaintenanceRequest[]

  @@index([buildingId])
  @@index([floorId])
}

// ==========================================
// TENANT MANAGEMENT
// ==========================================

model Tenant {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  fullName         String
  phone            String
  email            String?
  aadhaarNumber    String?
  occupantsCount   Int       @default(1)
  leaseStartDate   DateTime
  leaseEndDate     DateTime?
  assignedFlatId   String?   @db.ObjectId
  paymentMethodId  String?
  emergencyContact String?
  notes            String?
  tenantPin        String?
  isActive         Boolean   @default(true)
  whatsappOptIn    Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  flat                Flat?              @relation(fields: [assignedFlatId], references: [id])
  payments            Payment[]
  maintenanceRequests MaintenanceRequest[]
  whatsappMessages    WhatsAppLog[]

  @@index([assignedFlatId])
}

// ==========================================
// FINANCIAL ENGINE
// ==========================================

enum PaymentStatus {
  PAID
  PARTIAL
  OVERDUE
  PENDING
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  OTHER
}

model Payment {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  tenantId        String        @db.ObjectId
  flatId          String        @db.ObjectId
  month           DateTime
  rentDue         Float
  maintenanceDue  Float
  electricityDue  Float         @default(0.0)
  customDues      Float         @default(0.0)
  customDuesList  Json?         // Array of { label, amount, date }
  arrears         Float         @default(0.0)
  totalDue        Float
  amountPaid      Float         @default(0.0)
  balance         Float         @default(0.0)
  status          PaymentStatus @default(PENDING)
  paymentDate     DateTime?
  paymentMethod   PaymentMethod?
  receiptNumber   String?
  upiReference    String?       // For tracking UPI transaction IDs
  verifiedByOwner Boolean       @default(false)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  flat          Flat           @relation(fields: [flatId], references: [id])
  paymentProofs PaymentProof[]

  @@index([tenantId])
  @@index([flatId])
  @@index([tenantId, month])
}

model PaymentProof {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  paymentId        String   @db.ObjectId
  uploadedBy       String   // "tenant" or "owner"
  screenshotUrl    String
  upiTransactionId String?
  isVerified       Boolean  @default(false)
  verifiedAt       DateTime?
  notes            String?
  createdAt        DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
}

model MeterReading {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  flatId      String   @db.ObjectId
  reading     Float
  readingDate DateTime @default(now())
  month       Int
  year        Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  flat Flat @relation(fields: [flatId], references: [id])

  @@unique([flatId, month, year])
}

// ==========================================
// MAINTENANCE & COMPLAINTS
// ==========================================

enum MaintenanceCategory {
  PLUMBING
  ELECTRICAL
  CARPENTRY
  PAINTING
  CLEANING
  PEST_CONTROL
  OTHER
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model MaintenanceRequest {
  id          String              @id @default(auto()) @map("_id") @db.ObjectId
  flatId      String              @db.ObjectId
  tenantId    String?             @db.ObjectId
  buildingId  String              @db.ObjectId
  category    MaintenanceCategory @default(OTHER)
  title       String
  description String
  priority    MaintenancePriority @default(MEDIUM)
  status      MaintenanceStatus   @default(OPEN)
  images      String[]
  assignedTo  String?
  resolvedAt  DateTime?
  cost        Float?
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  flat     Flat     @relation(fields: [flatId], references: [id])
  tenant   Tenant?  @relation(fields: [tenantId], references: [id])
  building Building @relation(fields: [buildingId], references: [id])

  @@index([flatId])
  @@index([tenantId])
  @@index([buildingId])
}

// ==========================================
// WHATSAPP & COMMUNICATIONS
// ==========================================

enum WhatsAppMessageType {
  RENT_REMINDER
  PAYMENT_RECEIPT
  MAINTENANCE_UPDATE
  LEASE_ALERT
  BROADCAST
  INQUIRY_RESPONSE
}

enum WhatsAppStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

model WhatsAppLog {
  id          String              @id @default(auto()) @map("_id") @db.ObjectId
  tenantId    String?             @db.ObjectId
  phone       String
  messageType WhatsAppMessageType
  templateId  String?
  content     String
  status      WhatsAppStatus      @default(QUEUED)
  sentAt      DateTime?
  error       String?
  createdAt   DateTime            @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

// ==========================================
// TENANT INQUIRIES / LEADS
// ==========================================

enum InquirySource {
  WHATSAPP
  WEBSITE
  WALK_IN
  REFERRAL
  PHONE
}

enum InquiryStatus {
  NEW
  CONTACTED
  VIEWING_SCHEDULED
  CONVERTED
  REJECTED
}

model TenantInquiry {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  buildingId  String?       @db.ObjectId
  name        String
  phone       String
  email       String?
  flatType    String?
  budget      Float?
  message     String?
  source      InquirySource @default(WHATSAPP)
  status      InquiryStatus @default(NEW)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  building Building? @relation(fields: [buildingId], references: [id])

  @@index([buildingId])
}

// ==========================================
// NOTIFICATIONS
// ==========================================

enum NotificationType {
  PAYMENT_RECEIVED
  PAYMENT_OVERDUE
  PAYMENT_PROOF_UPLOADED
  LEASE_EXPIRING
  MAINTENANCE_NEW
  MAINTENANCE_RESOLVED
  VACANCY_ALERT
  INQUIRY_NEW
  SUBSCRIPTION_PAYMENT
  ORG_ACTIVATED
  SYSTEM
}

model Notification {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String?          @db.ObjectId  // null for super admin notifications
  type           NotificationType
  title          String
  message        String
  isRead         Boolean          @default(false)
  data           String?
  createdAt      DateTime         @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model PushSubscription {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @db.ObjectId
  endpoint       String   @unique
  p256dh         String
  auth           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
